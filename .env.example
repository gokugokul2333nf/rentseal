# Google Apps Script Web App URL that appends submissions to the order sheet.
# Setup: docs/google-sheet-webhook.md
# Server-side only — never prefix this with NEXT_PUBLIC_.
SHEETS_WEBHOOK_URL=

# Order email — see docs/order-email.md
# Gmail requires a 16-character App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where every lead is sent — enquiries and drafted agreements, the latter with
# the deed attached as a PDF. One address, or several separated by commas.
# Defaults to SMTP_USER.
ORDER_EMAIL=lpscanxerox@gmail.com,gokulgokul077g@gmail.com

